# Tavily API key for the real web_search tool.
TAVILY_API_KEY=

# Ollama model used for page processing semantic classification.
JOB_RADAR_PAGE_ANALYSIS_MODEL=gpt-oss:20b-cloud

# Ollama model used for structured job extraction.
JOB_RADAR_EXTRACTION_MODEL=gpt-oss:20b-cloud

# Ollama model used to understand prepared jobs.
JOB_RADAR_UNDERSTANDING_MODEL=gpt-oss:20b-cloud

# Ollama model used for semantic profile matching.
JOB_RADAR_MATCH_MODEL=gpt-oss:20b-cloud

# Local Ollama endpoint used by the other model-backed pipeline stages.
OLLAMA_BASE_URL=http://localhost:11434

# Ollama model used by the workflow LLM controller.
JOB_RADAR_CONTROLLER_MODEL=qwen3:8b
JOB_RADAR_CONTROLLER_TIMEOUT_SECONDS=60

# Ollama model used to summarize the semantic outcome of the last action.
CONTROLLER_ACTION_SUMMARY_MODEL=qwen3:8b
CONTROLLER_ACTION_SUMMARY_TIMEOUT_SECONDS=60
